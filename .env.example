# ── AI Provider Configuration ────────────────────────────────
AI_PROVIDER=9router # 9router | openai | gemini | mock

# ── 9Router AI Proxy ─────────────────────────────────────────
NINE_ROUTER_BASE_URL=http://localhost:20218/v1
NINE_ROUTER_AUTH_TOKEN=sk-1163473d6c634be7-19n2jq-dfb32539
NINE_ROUTER_MODEL=mimo

# ── OpenAI / Gemini Direct Adapters ──────────────────────────
AI_MODEL=gpt-4o
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ── Target Application ───────────────────────────────────────
BASE_URL=https://staging.example.com

# ── Playwright Configuration ─────────────────────────────────
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT=30000

# ── Agent Automation Configuration ───────────────────────────
MAX_REPAIR_ATTEMPTS=3
MAX_CRAWL_PAGES=20
MAX_CRAWL_DEPTH=3
